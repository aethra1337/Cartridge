VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
# Local dev (self-signed HTTPS):
VITE_SPOTIFY_REDIRECT_URI=https://localhost:5173/callback
# Production (Cloudflare Pages): set this in the Pages dashboard instead,
# e.g. VITE_SPOTIFY_REDIRECT_URI=https://cartridge.pages.dev/callback
# and register the same URL in the Spotify dashboard.